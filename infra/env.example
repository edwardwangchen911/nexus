# Runtime environment: development, test, or production.
NEXUS_ENV=
# PostgreSQL connection used by the engine.
DATABASE_URL=
# Object-store location and credentials used by the engine and app-profile initializer.
# All six values above/below must be non-empty. The initializer creates the exact bucket only in
# development/test; production requires a pre-provisioned bucket and fails closed when it is absent.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=
OBJECT_STORE_BUCKET=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
# Service-to-service authentication and isolated gateway configuration.
NEXUS_ENGINE_BASE_URL=
NEXUS_ENGINE_HMAC_CURRENT_KEY_ID=
NEXUS_ENGINE_HMAC_CURRENT_SECRET=
NEXUS_ENGINE_HMAC_PREVIOUS_KEY_ID=
NEXUS_ENGINE_HMAC_PREVIOUS_SECRET=
# Deprecated compatibility input; migrate to NEXUS_ENGINE_HMAC_CURRENT_SECRET.
NEXUS_ENGINE_HMAC_SECRET=
FOSUN_GATEWAY_BASE_URL=https://fosun-gateway:8081
# Engine-side mTLS client identity. These are not the gateway server identity below.
FOSUN_GATEWAY_CLIENT_CERT=
FOSUN_GATEWAY_CLIENT_KEY=
FOSUN_GATEWAY_CLIENT_CA=
# Independent engine-to-gateway HMAC rotation domain.
FOSUN_GATEWAY_REPLICA_COUNT=1
FOSUN_GATEWAY_REPLAY_STORE_PATH=/var/lib/nexus-fosun-gateway/replay.sqlite3
FOSUN_GATEWAY_HMAC_CURRENT_KEY_ID=
FOSUN_GATEWAY_HMAC_CURRENT_SECRET=
FOSUN_GATEWAY_HMAC_PREVIOUS_KEY_ID=
FOSUN_GATEWAY_HMAC_PREVIOUS_SECRET=
# Independent Provider Worker market-only mTLS/HMAC identity.
FOSUN_MARKET_GATEWAY_BASE_URL=https://fosun-gateway:8082
FOSUN_MARKET_GATEWAY_CLIENT_CERT=
FOSUN_MARKET_GATEWAY_CLIENT_KEY=
FOSUN_MARKET_GATEWAY_CLIENT_CA=
FOSUN_MARKET_GATEWAY_HMAC_CURRENT_KEY_ID=
FOSUN_MARKET_GATEWAY_HMAC_CURRENT_SECRET=
FOSUN_MARKET_GATEWAY_HMAC_PREVIOUS_KEY_ID=
FOSUN_MARKET_GATEWAY_HMAC_PREVIOUS_SECRET=
# Broker-worker-only external account ID encryption rotation domain.
NEXUS_BROKER_EXTERNAL_ID_AEAD_CURRENT_KEY=
NEXUS_BROKER_EXTERNAL_ID_AEAD_CURRENT_KEY_VERSION=
NEXUS_BROKER_EXTERNAL_ID_AEAD_PREVIOUS_KEY=
NEXUS_BROKER_EXTERNAL_ID_AEAD_PREVIOUS_KEY_VERSION=
NEXUS_BROKER_EXTERNAL_ID_BLIND_INDEX_KEY=
FOSUN_GATEWAY_CAPABILITY=
FOSUN_GATEWAY_TRANSPORT_MODE=
# Gateway-side mTLS server identity and two dedicated single-certificate client trust roots.
# Broker port 8081 and market port 8082 must use different CA certificates, not aliases or bundles.
FOSUN_GATEWAY_SERVER_CERT=
FOSUN_GATEWAY_SERVER_KEY=
FOSUN_GATEWAY_SERVER_BROKER_CLIENT_CA=
FOSUN_GATEWAY_SERVER_MARKET_CLIENT_CA=
# Must remain false until every gate in docs/runbooks/fosun-sdk-admission.md is complete.
FOSUN_SDK_ADMITTED=false
# Change-controlled activation inputs. Compose fixes all container targets. The two evidence files
# are independent read-only binds; the non-secret publisher pin and contract hash are separate
# file-backed configs. Missing files fail at startup and none is shared with general workers.
FOSUN_ACTIVATION_PROBE_ARTIFACT_HOST_FILE=../.secrets/fosun-activation/probe-artifact.json
FOSUN_ACTIVATION_PROBE_RECEIPT_HOST_FILE=../.secrets/fosun-activation/publication-receipt.json
# Probe-only process settings. The private seed file is secret, current-user 0600, and its parent
# directory is current-user 0700. These are not passed to the long-running Gateway service.
FOSUN_PROVIDER_MANIFEST=
FOSUN_PROBE_OUTPUT_DIR=
FOSUN_PROBE_PUBLISHER_PRIVATE_KEY_FILE=
FOSUN_ACTIVATION_PROBE_PUBLISHER_PUBLIC_KEY_B64U=
# The one-shot local probe pins this exact loopback proxy; the long-running Gateway ignores it.
FOSUN_PROBE_HTTPS_PROXY_URL=http://127.0.0.1:9090
# Gateway provider settings. Keep values in a secret manager, never this file.
# FSOPENAPI_BASE_URL must exactly match the admitted manifest HTTPS value.
FSOPENAPI_API_KEY=
FSOPENAPI_CLIENT_PRIVATE_KEY=
FSOPENAPI_SERVER_PUBLIC_KEY=
FSOPENAPI_BASE_URL=
# Optional worker-only model credentials and model identifiers.
# Defaults to fixture for reproducible offline Compose. Set responses explicitly only when the
# three values below are configured through the appropriate secret/configuration domains.
AGENT_RUNTIME_MODE=fixture
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=
OPENAI_REASONING_MODEL=
# The general worker remains the sole daily root owner. Provider stages are
# materialized on the provider queue only after a separately approved activation.
NEXUS_PROVIDER_JOBS_ENABLED=false
# Research-data mode. The ordinary app profile remains fixture-only; the explicit provider
# profile forces production and requires the secret values from an approved secret domain.
NEXUS_PROVIDER_RUNTIME_MODE=fixture
# Optional deployment hardening overrides. Local provider workers reuse DATABASE_URL and the
# shared object-store settings when these values are empty; production deployments may inject
# narrower principals without changing the application contract.
PROVIDER_DATABASE_URL=
# Provider evidence remains confined to provider/market. A hardened deployment can use a narrower
# object-store principal; ordinary Mac-local use does not require a second MinIO identity.
PROVIDER_OBJECT_STORE_ENDPOINT=
PROVIDER_OBJECT_STORE_REGION=
PROVIDER_OBJECT_STORE_BUCKET=
PROVIDER_OBJECT_STORE_ACCESS_KEY_ID=
PROVIDER_OBJECT_STORE_SECRET_ACCESS_KEY=
PROVIDER_OBJECT_STORE_PREFIX=provider/market
# The general worker uses this non-secret selector when it freezes the sole daily root.
# The selected source must match the one explicit provider profile started below.
NEXUS_MARKET_PROVIDER=fosun
# Optional snapshot-only override. Set schwab to retain Fosun for daily data while using one
# bounded Schwab Level One capture for each admitted intraday Job.
NEXUS_INTRADAY_PROVIDER=
# The Fosun `provider` profile hard-codes disabled; the mutually exclusive
# `provider-alpaca` profile hard-codes enabled after a separate admission.
NEXUS_ALPACA_MARKET_MODE=disabled
FOSUN_MARKET_DELIVERY_MODE=unknown
# Alpaca-only provider profile. These values are never mapped into the Fosun worker.
ALPACA_DATA_FEED=
ALPACA_DELIVERY_MODE=
# Display-only minute monitor. Fosun is capped at 10 symbols; Alpaca and Schwab
# are capped at 30. Feed/delivery below are mapped only to provider-alpaca
# and must be an admitted pair: iex|sip + real_time, or delayed_sip + delayed.
NEXUS_INTRADAY_MONITOR_MODE=disabled
NEXUS_INTRADAY_POLL_SECONDS=15
NEXUS_INTRADAY_MAX_SYMBOLS=10
ALPACA_INTRADAY_FEED=
ALPACA_INTRADAY_DELIVERY_MODE=
# Shared independent research sources for either provider profile.
SEC_CONTACT=
# ALPACA_API_KEY_ID, ALPACA_API_SECRET_KEY, and FRED_API_KEY must not be committed here.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FRED_API_KEY=
# Phase 3A broker-simulation profile. These names form a secret/configuration
# domain distinct from the read-only Gateway above. The committed profile is a
# static offline gate only: no Provider credential variables are mapped and the
# broker mode remains offline_fixture. Do not populate or start it for Phase 3B
# without the separately approved activation package and runbook window.
NEXUS_BROKER_SIMULATION_ENV=test
FOSUN_SIMULATION_GATEWAY_BASE_URL=
FOSUN_SIMULATION_GATEWAY_HMAC_CURRENT_KEY_ID=
FOSUN_SIMULATION_GATEWAY_HMAC_CURRENT_SECRET=
FOSUN_SIMULATION_GATEWAY_HMAC_PREVIOUS_KEY_ID=
FOSUN_SIMULATION_GATEWAY_HMAC_PREVIOUS_SECRET=
FOSUN_SIMULATION_GATEWAY_CLIENT_CERT=
FOSUN_SIMULATION_GATEWAY_CLIENT_KEY=
FOSUN_SIMULATION_GATEWAY_CLIENT_CA=
FOSUN_SIMULATION_GATEWAY_SERVER_CERT=
FOSUN_SIMULATION_GATEWAY_SERVER_KEY=
FOSUN_SIMULATION_GATEWAY_SERVER_CLIENT_CA=
NEXUS_SIMULATION_EXTERNAL_ID_AEAD_CURRENT_KEY=
NEXUS_SIMULATION_EXTERNAL_ID_AEAD_CURRENT_KEY_VERSION=
NEXUS_SIMULATION_EXTERNAL_ID_AEAD_PREVIOUS_KEY=
NEXUS_SIMULATION_EXTERNAL_ID_AEAD_PREVIOUS_KEY_VERSION=
NEXUS_SIMULATION_EXTERNAL_ID_BLIND_INDEX_KEY=
# Local PostgreSQL and MinIO bootstrap variables.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Optional loopback host-port overrides when defaults are already occupied.
NEXUS_POSTGRES_HOST_PORT=5432
NEXUS_MINIO_HOST_PORT=9000
NEXUS_MINIO_CONSOLE_HOST_PORT=9001
NEXUS_API_HOST_PORT=8000

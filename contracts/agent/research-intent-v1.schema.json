{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus://contracts/agent/research-intent-v1.schema.json",
  "title": "NEXUS ResearchIntent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "instrument_id", "display_symbol", "decision_time", "data_snapshot_id", "horizon", "stance", "exposure_action", "theses", "counter_theses", "uncertainties", "invalidation_conditions", "entry_conditions", "exit_conditions", "valid_until", "quality_status", "evidence_audit", "role_votes", "disagreement", "strategy_version", "model_version", "prompt_version", "data_version", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "research_intent_v1"},
    "decision_id": {"type": "string", "format": "uuid"},
    "instrument_id": {"type": "string", "format": "uuid"},
    "display_symbol": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Z0-9.\\-]+$"},
    "decision_time": {"type": "string", "format": "date-time"},
    "data_snapshot_id": {"type": "string", "format": "uuid"},
    "horizon": {"enum": ["short_term", "medium_term", "long_term"]},
    "stance": {"enum": ["buy_candidate", "reduce_candidate", "hold", "watch"]},
    "exposure_action": {"enum": ["none", "reduce", "maintain", "eligible_for_increase"]},
    "theses": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/claim"}},
    "counter_theses": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/claim"}},
    "uncertainties": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/safeText"}},
    "invalidation_conditions": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/safeText"}},
    "entry_conditions": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/safeText"}},
    "exit_conditions": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/safeText"}},
    "valid_until": {"type": "string", "format": "date-time"},
    "quality_status": {"enum": ["complete", "partial"]},
    "evidence_audit": {"enum": ["complete", "partial", "failed"]},
    "role_votes": {"type": "object", "additionalProperties": {"enum": ["support", "oppose", "abstain"]}},
    "disagreement": {"allOf": [{"$ref": "#/$defs/safeText"}, {"maxLength": 500}]},
    "strategy_version": {"allOf": [{"$ref": "#/$defs/safeText"}, {"maxLength": 100}]},
    "model_version": {"allOf": [{"$ref": "#/$defs/safeText"}, {"maxLength": 100}]},
    "prompt_version": {"allOf": [{"$ref": "#/$defs/safeText"}, {"maxLength": 100}]},
    "data_version": {"allOf": [{"$ref": "#/$defs/safeText"}, {"maxLength": 100}]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}}
  },
  "$defs": {
    "safeText": {"type": "string", "minLength": 1, "maxLength": 1000, "not": {"pattern": "(?i)(https?://|file://|\\.\\./|\\\\|;|\\||&&|`|\\b(select|insert|update|delete|import|curl|wget|bash|sh)\\b|exec\\(|eval\\()"}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["text", "evidence_refs"], "properties": {"text": {"$ref": "#/$defs/safeText"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}}}},
    "evidenceRef": {"type": "object", "additionalProperties": false, "required": ["source", "object_id", "available_at", "location", "content_hash"], "properties": {"source": {"$ref": "#/$defs/safeText"}, "object_id": {"$ref": "#/$defs/safeText"}, "available_at": {"type": "string", "format": "date-time"}, "location": {"$ref": "#/$defs/safeText"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}

{
  "components": {
    "schemas": {
      "ErrorCode": {
        "description": "Client-visible error codes defined by the API contract.",
        "enum": [
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "VALIDATION_ERROR",
          "NOT_FOUND",
          "VERSION_CONFLICT",
          "IDEMPOTENCY_CONFLICT",
          "DATA_PARTIAL",
          "DATA_STALE",
          "BROKER_STALE",
          "SOURCE_CONFLICT",
          "CAPABILITY_EXPIRED",
          "PROPOSAL_NOT_EXECUTABLE",
          "ACCOUNT_TYPE_MISMATCH",
          "APPROVAL_REQUIRED",
          "RISK_REJECTED",
          "DRAWDOWN_LOCKED",
          "RECONCILIATION_REQUIRED",
          "BUDGET_EXHAUSTED",
          "PROVIDER_UNAVAILABLE",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "IntegrationConnectivityTestRequest": {
        "additionalProperties": false,
        "description": "A deliberately empty non-trading fixture connectivity request.",
        "properties": {},
        "title": "IntegrationConnectivityTestRequest",
        "type": "object"
      },
      "IntegrationConnectivityTestResponse": {
        "additionalProperties": false,
        "description": "The response to a fixture-only connectivity refresh.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/IntegrationStatusResponse"
          },
          "meta": {
            "$ref": "#/components/schemas/SuccessMetaResponse"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "IntegrationConnectivityTestResponse",
        "type": "object"
      },
      "IntegrationModeChangeRequest": {
        "additionalProperties": false,
        "description": "The only safe mode values accepted by the engine contract.",
        "properties": {
          "mode": {
            "enum": [
              "disabled",
              "fixture",
              "read_only"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "required": [
          "mode"
        ],
        "title": "IntegrationModeChangeRequest",
        "type": "object"
      },
      "IntegrationModeChangeResponse": {
        "additionalProperties": false,
        "description": "The response to a safe persisted mode change.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/IntegrationStatusResponse"
          },
          "meta": {
            "$ref": "#/components/schemas/SuccessMetaResponse"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "IntegrationModeChangeResponse",
        "type": "object"
      },
      "IntegrationStatusListEnvelope": {
        "additionalProperties": false,
        "description": "A complete deterministic integration status list.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/IntegrationStatusResponse"
            },
            "title": "Data",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/SuccessMetaResponse"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "IntegrationStatusListEnvelope",
        "type": "object"
      },
      "IntegrationStatusResponse": {
        "additionalProperties": false,
        "description": "A provider's safe-to-display capability and fixture state.",
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "capability_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capability Expires At"
          },
          "contract_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contract Hash"
          },
          "mode": {
            "enum": [
              "disabled",
              "fixture",
              "read_only"
            ],
            "title": "Mode",
            "type": "string"
          },
          "next_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Action"
          },
          "provider": {
            "enum": [
              "fosun",
              "alpaca",
              "sec",
              "fred",
              "openai"
            ],
            "title": "Provider",
            "type": "string"
          },
          "quality": {
            "enum": [
              "PASS",
              "PARTIAL",
              "FAIL"
            ],
            "title": "Quality",
            "type": "string"
          },
          "version": {
            "minimum": 0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "provider",
          "mode",
          "quality",
          "as_of",
          "capability_expires_at",
          "contract_hash",
          "next_action",
          "version"
        ],
        "title": "IntegrationStatusResponse",
        "type": "object"
      },
      "NexusErrorEnvelope": {
        "additionalProperties": false,
        "description": "The public stable error envelope.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/NexusErrorResponse"
          }
        },
        "required": [
          "error"
        ],
        "title": "NexusErrorEnvelope",
        "type": "object"
      },
      "NexusErrorResponse": {
        "additionalProperties": false,
        "description": "The stable public error body used by every documented failure response.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "title": "NexusErrorResponse",
        "type": "object"
      },
      "SuccessMetaResponse": {
        "additionalProperties": false,
        "description": "The stable public success metadata shape.",
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1",
            "default": "1",
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "as_of"
        ],
        "title": "SuccessMetaResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "NEXUS Engine",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Liveness Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness"
      }
    },
    "/internal/v1/integrations": {
      "get": {
        "description": "List baseline status, overridden only by admitted persisted modes.",
        "operationId": "listIntegrationStatuses",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationStatusListEnvelope"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NexusErrorEnvelope"
                }
              }
            },
            "description": "Stable NEXUS error envelope."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NexusErrorEnvelope"
                }
              }
            },
            "description": "Stable NEXUS error envelope."
          }
        },
        "summary": "List Integration Statuses"
      }
    },
    "/internal/v1/integrations/{provider}/mode": {
      "post": {
        "description": "Persist a policy-checked mode with replay and optimistic-lock controls.",
        "operationId": "changeIntegrationMode",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "enum": [
                "fosun",
                "alpaca",
                "sec",
                "fred",
                "openai"
              ],
              "title": "Provider",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "title": "If-Match",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntegrationModeChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationModeChangeResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NexusErrorEnvelope"
                }
              }
            },
            "description": "Stable NEXUS error envelope."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NexusErrorEnvelope"
                }
              }
            },
            "description": "Stable NEXUS error envelope."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NexusErrorEnvelope"
                }
              }
            },
            "description": "Stable NEXUS error envelope."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NexusErrorEnvelope"
                }
              }
            },
            "description": "Stable NEXUS error envelope."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NexusErrorEnvelope"
                }
              }
            },
            "description": "Stable NEXUS error envelope."
          }
        },
        "summary": "Change Integration Mode"
      }
    },
    "/internal/v1/integrations/{provider}/test": {
      "post": {
        "description": "Refresh only the Fosun fixture through replay and version controls.",
        "operationId": "testIntegrationConnectivity",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "enum": [
                "fosun",
                "alpaca",
                "sec",
                "fred",
                "openai"
              ],
              "title": "Provider",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "title": "If-Match",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntegrationConnectivityTestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationConnectivityTestResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NexusErrorEnvelope"
                }
              }
            },
            "description": "Stable NEXUS error envelope."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NexusErrorEnvelope"
                }
              }
            },
            "description": "Stable NEXUS error envelope."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NexusErrorEnvelope"
                }
              }
            },
            "description": "Stable NEXUS error envelope."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NexusErrorEnvelope"
                }
              }
            },
            "description": "Stable NEXUS error envelope."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NexusErrorEnvelope"
                }
              }
            },
            "description": "Stable NEXUS error envelope."
          }
        },
        "summary": "Test Integration Connectivity"
      }
    },
    "/internal/v1/system-status": {
      "get": {
        "description": "Return a fixture-only status envelope without exposing configuration.",
        "operationId": "system_status_internal_v1_system_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response System Status Internal V1 System Status Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "System Status"
      }
    }
  }
}
